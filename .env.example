# Copy to .env and fill in. Never commit .env.

# Required. Gemini API key from https://aistudio.google.com
# (use a project with billing enabled when the app is used by people in the EEA)
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite   # tried in order
# CHAT_TIMEOUT_SECONDS=10                                    # per model, minimum 10
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=768
# EMBED_BATCH_SIZE=20
# CHUNK_SIZE=3000
# CHUNK_OVERLAP=400
# TOP_K=5
